
{% extends "template.njk" %}

{% block pageTitle %}
  Select a caseworker - HMCTS
{% endblock %}

{% block content %}
  <h1 class="govuk-heading-l">Select a caseworker</h1>

  <p class="govuk-body">
    Choose a caseworker to explore the task management application.
  </p>

  <div class="govuk-inset-text">
    <strong>Demonstration mode:</strong>
    Selecting a caseworker simulates signing in as that user.
    Authentication and access controls are not implemented.
  </div>

  {% if caseworkers.length %}
    <ul class="govuk-list">
      {% for caseworker in caseworkers %}
        <li>
          <a class="govuk-link" href="/cases?caseworkerId={{ caseworker.id }}">
            {{ caseworker.name }}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="govuk-body">No caseworkers available.</p>
  {% endif %}
{% endblock %}
