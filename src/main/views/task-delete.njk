{% extends "template.njk" %}

{% block pageTitle %}
  Delete task - HMCTS Dev Test
{% endblock %}

{% block content %}
  <a href="{{ cancelUrl }}" class="govuk-back-link">
    {% if returnTo == "case" %}
        Back to case
    {% else %}
        Back to task
    {% endif %}
  </a>

  <h1 class="govuk-heading-l">
    Are you sure you want to delete this task?
  </h1>

  <p class="govuk-body">
    You are about to delete <strong>{{ task.title }}</strong>.
  </p>

  <p class="govuk-body">
    This action cannot be undone.
  </p>

  <form
    method="post"
    action="/tasks/{{ task.id }}/delete?caseworkerId={{ caseworker.id }}"
  >
    <button
      type="submit"
      class="govuk-button govuk-button--warning"
      data-module="govuk-button"
    >
      Delete task
    </button>

    <a
      href="{{ cancelUrl }}"
      class="govuk-link govuk-!-margin-left-3"
    >
      Cancel
    </a>
  </form>
{% endblock %}
