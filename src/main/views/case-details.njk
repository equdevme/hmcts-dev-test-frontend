
{% extends "template.njk" %}

{% block pageTitle %}
  {{ caseItem.title }} - HMCTS
{% endblock %}

{% block content %}
  <a
    href="/cases?caseworkerId={{ caseworker.id }}"
    class="govuk-back-link"
  >
    Back to cases
  </a>

  <h1 class="govuk-heading-l">{{ caseItem.title }}</h1>

  <p class="govuk-body">
    Viewing as: <strong>{{ caseworker.name }}</strong>
  </p>

  <h2 class="govuk-heading-m">Case details</h2>

  <dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Case reference</dt>
      <dd class="govuk-summary-list__value">{{ caseItem.id }}</dd>
    </div>

    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Owner</dt>
      <dd class="govuk-summary-list__value">{{ ownerName }}</dd>
    </div>

    <div class="govuk-summary-list__row">
      <dt class="govuk-summary-list__key">Description</dt>
      <dd class="govuk-summary-list__value">
        {{ caseItem.description or "No description provided" }}
      </dd>
    </div>
  </dl>

  <h2 class="govuk-heading-m">Tasks</h2>

  {# Task controls: creation, filtering and sorting #}
  <div
    class="govuk-!-margin-bottom-5"
    style="display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap;"
  >
    {# Create task button — left aligned #}
    <a
      href="/cases/{{ caseItem.id }}/tasks/new?caseworkerId={{ caseworker.id }}"
      class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
      data-module="govuk-button"
    >
      Create a task
    </a>

    {# Filtering and sorting — right aligned #}
    {% if hasTasks %}
      <form
        method="get"
        action="/cases/{{ caseItem.id }}"
        style="margin-left: auto;"
      >
        <input
          type="hidden"
          name="caseworkerId"
          value="{{ caseworker.id }}"
        >

        <div
          style="display: flex; align-items: flex-end; gap: 15px; flex-wrap: wrap;"
        >
          <div class="govuk-form-group govuk-!-margin-bottom-0">
            <label class="govuk-label" for="status-filter">
              Filter tasks by status
            </label>

            <select
              class="govuk-select"
              id="status-filter"
              name="status"
            >
              <option value="">All statuses</option>

              {% for taskStatus in taskStatuses %}
                <option
                  value="{{ taskStatus.code }}"
                  {% if selectedStatus == taskStatus.code %}selected{% endif %}
                >
                  {{ taskStatus.label }}
                </option>
              {% endfor %}
            </select>
          </div>

          <div class="govuk-form-group govuk-!-margin-bottom-0">
            <label class="govuk-label" for="sort-order">
              Sort by due date
            </label>

            <select
              class="govuk-select"
              id="sort-order"
              name="sort"
            >
              <option
                value="asc"
                {% if selectedSort != "desc" %}selected{% endif %}
              >
                Earliest first
              </option>
              <option
                value="desc"
                {% if selectedSort == "desc" %}selected{% endif %}
              >
                Latest first
              </option>
            </select>
          </div>

          <button
            type="submit"
            class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
            data-module="govuk-button"
          >
            Apply
          </button>
        </div>
      </form>
    {% endif %}
  </div>

  {# Task table #}
  {% if tasks.length %}
    <table class="govuk-table">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Title</th>
          <th scope="col" class="govuk-table__header">Status</th>
          <th scope="col" class="govuk-table__header">Due date</th>
          <th scope="col" class="govuk-table__header">Actions</th>
        </tr>
      </thead>

      <tbody class="govuk-table__body">
        {% for task in tasks %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a
                class="govuk-link"
                href="/tasks/{{ task.id }}?caseworkerId={{ caseworker.id }}"
              >
                {{ task.title }}
              </a>
            </td>

            <td class="govuk-table__cell">
              {% for taskStatus in taskStatuses %}
                {% if task.status == taskStatus.code %}
                  {{ taskStatus.label }}
                {% endif %}
              {% endfor %}
            </td>

            <td class="govuk-table__cell">
              {{ task.formattedDueAt }}
            </td>

            <td class="govuk-table__cell">
              <a
                href="/tasks/{{ task.id }}/delete?caseworkerId={{ caseworker.id }}&returnTo=case"
                class="govuk-link"
              >
                Delete
                <span class="govuk-visually-hidden">
                  {{ task.title }}
                </span>
              </a>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    {% if selectedStatus %}
      <p class="govuk-body">
        No tasks match the selected status.
      </p>
    {% else %}
      <p class="govuk-body">
        No tasks have been created for this case.
      </p>
    {% endif %}
  {% endif %}

{% endblock %}
